# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/mock-api-service?retryWrites=true&w=majority

# Frontend URL for CORS
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=<random-64-char-hex-string>
JWT_EXPIRES_IN=7d

# SMTP Configuration (for OTP emails)
# Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Weekly Rate Limit (per API key, requests per 7 days)
WEEKLY_RATE_LIMIT=500

# Monitoring — Loki log aggregation (used by winston-loki)
LOKI_HOST=http://127.0.0.1:3100
